 "guides": [
  {
   "id": "wifi",
   "title": {
    "en": "Turn on Wi-Fi",
    "ny": "Yatsani Wi-Fi",
    "bem": "Pyungeni Wi-Fi"
   },
   "done": {
    "en": "Well done! Wi-Fi is on.",
    "ny": "Zabwino! Wi-Fi yayatsidwa.",
    "bem": "Nawamya! Wi-Fi yapyungwa."
   },
   "steps": [
    {
     "match": [
      "Settings",
      "Setting"
     ],
     "audio": "wifi_1",
     "say": {
      "en": "Tap Settings.",
      "ny": "Dinani Settings.",
      "bem": "Kandeni Settings."
     },
     "skipIn": "settings"
    },
    {
     "match": [
      "Network & internet",
      "Connections",
      "WLAN",
      "Wi-Fi"
     ],
     "audio": "wifi_2",
     "say": {
      "en": "Tap the glowing row.",
      "ny": "Dinani pamene pawala.",
      "bem": "Kandeni apabalima."
     }
    },
    {
     "match": [
      "Internet"
     ],
     "audio": "wifi_3",
     "say": {
      "en": "Tap Internet.",
      "ny": "Dinani Internet.",
      "bem": "Kandeni Internet."
     }
    },
    {
     "match": [
      "Wi-Fi",
      "WLAN",
      "Use Wi-Fi"
     ],
     "toggle": true,
     "audio": "wifi_4",
     "say": {
      "en": "Tap the switch to turn Wi-Fi on.",
      "ny": "Dinani kuti muyatse Wi-Fi.",
      "bem": "Kandeni ukupyunga Wi-Fi."
     }
    }
   ],
   "keywords": [
    "wifi",
    "wi-fi",
    "wlan",
    "wireless",
    "internet"
   ],
   "doneWhen": "wifi_on"
  },
